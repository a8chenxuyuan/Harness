# ===== 模型 =====
# 默认供应商：openai_compat（覆盖 OpenAI / DeepSeek / Kimi / 通义 / Ollama）
HARNESS_MODEL_PROVIDER=openai_compat
HARNESS_MODEL_NAME=deepseek-chat
HARNESS_MODEL_BASE_URL=https://api.deepseek.com/v1
HARNESS_MODEL_API_KEY=
HARNESS_MODEL_TIMEOUT_SECONDS=120
HARNESS_MODEL_MAX_RETRIES=2

# 缓存画像：explicit / automatic / none
# explicit   = 可传 cache_control（Anthropic）
# automatic  = 无法传参，只能靠前缀字节稳定（DeepSeek / Kimi / 通义 / GLM）
# none       = 不支持缓存（部分本地部署）
# 留空则由供应商适配器自动探测
HARNESS_CACHE_MODE=
HARNESS_CACHE_MIN_TOKENS=1024
HARNESS_CACHE_TTL=5m

# ===== 运行时 =====
HARNESS_MAX_STEPS=20
HARNESS_MAX_OUTPUT_TOKENS=2048
HARNESS_TOOL_RESULT_TOKEN_LIMIT=8000
HARNESS_PARALLEL_READONLY=true

# ===== 会话与存储 =====
HARNESS_SESSION_DB=./data/harness.db
HARNESS_COMPACTION_ENABLED=true
HARNESS_COMPACTION_KEEP_RECENT_TOKENS=20000
HARNESS_COMPACTION_RESERVE_TOKENS=16384

# ===== 权限 =====
# DEFAULT / ACCEPT_EDITS / EXPLORE / DONTF_ASK / BYPASS
HARNESS_PERMISSION_MODE=DEFAULT
HARNESS_COMMAND_TIMEOUT_SECONDS=30

# ===== 渠道 =====
HARNESS_GATEWAY_HOST=127.0.0.1
HARNESS_GATEWAY_PORT=8080
HARNESS_WEBCHAT_ENABLED=true
HARNESS_FEISHU_APP_ID=
HARNESS_FEISHU_APP_SECRET=
HARNESS_FEISHU_VERIFY_TOKEN=

# ===== MCP =====
HARNESS_MCP_SERVERS=./config/mcp_servers.json

# ===== 可观测 =====
HARNESS_LOG_LEVEL=INFO
HARNESS_LOG_JSON=true
HARNESS_OTEL_ENABLED=false
HARNESS_OTEL_ENDPOINT=http://localhost:4317
HARNESS_METRICS_ENABLED=true
HARNESS_METRICS_PORT=9090
HARNESS_TRACE_JSONL=./data/traces.jsonl

# ===== Skill =====
HARNESS_SKILLS_DIRS=./skills,~/.harness/skills
