# =====================================================================
# Harness 环境变量样例：复制为 .env 后按需修改
# 变量前缀统一为 HARNESS_，嵌套字段用双下划线，例如 HARNESS_MODEL__API_KEY
# 未设置时使用代码内默认值（SQLite + dev secret + 无模型凭据）
# =====================================================================

# --- 数据库 ---------------------------------------------------------
# PostgreSQL 示例（docker compose 起的 harness-pg 映射到 5433）
# HARNESS_DATABASE_URL=postgresql+asyncpg://harness:harness_secret@localhost:5433/harness
# 留空则回退 sqlite+aiosqlite:///./harness.db
HARNESS_DATABASE_URL=

# --- 认证与安全 -----------------------------------------------------
# 生产必须覆盖；空串使用内置 dev secret
HARNESS_JWT_SECRET=
# true 时无 token 请求按 dev-tenant owner 放行，生产必须为 false
HARNESS_DEV_MODE=false
# CORS 白名单，JSON 数组
# HARNESS_CORS_ORIGINS=["http://localhost:5173"]

# --- 服务端口 -------------------------------------------------------
HARNESS_API_HOST=0.0.0.0
HARNESS_API_PORT=8000

# --- 大模型（W1-MODEL-01）------------------------------------------
# provider 可选：deepseek / openai / anthropic / kimi / ollama
# base_url 留空由适配器按 provider 推断，自建/第三方兼容端点需显式填写
HARNESS_MODEL__PROVIDER=deepseek
HARNESS_MODEL__BASE_URL=https://api.deepseek.com/v1
HARNESS_MODEL__API_KEY=
HARNESS_MODEL__MODEL=deepseek-chat

# Anthropic 示例：
# HARNESS_MODEL__PROVIDER=anthropic
# HARNESS_MODEL__BASE_URL=
# HARNESS_MODEL__API_KEY=sk-ant-xxxx
# HARNESS_MODEL__MODEL=claude-3-5-sonnet-latest

# --- 可观测 ---------------------------------------------------------
# HARNESS_OTLP_ENDPOINT=http://localhost:4317
HARNESS_PROMETHEUS_PORT=9700
